# ============================================
# Sarabun PDF API - Environment Configuration
# ============================================
# แก้ไขไฟล์นี้เพื่อเปลี่ยน port และ settings อื่นๆ

# Port ที่เปิดให้เข้าถึงจากภายนอก (host)
HOST_PORT=8889

# Port ภายใน container
CONTAINER_PORT=8888

# Image name and tag
IMAGE_NAME=sarabun-pdf-api
IMAGE_TAG=1.0.0

# Container name
CONTAINER_NAME=sarabun-pdf-api

# JVM Settings
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseContainerSupport

# Logging
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO

# Spring Profile
SPRING_PROFILE=prod

# ============================================
# API Security
# ============================================
# เปิด/ปิด API Key authentication
# - true: ต้องใช้ API Key (production)
# - false: ไม่ต้องใช้ API Key (development)
API_SECURITY_ENABLED=true

# API Key - *** สำคัญ: ต้องเปลี่ยนค่านี้ก่อนใช้งานจริง! ***
# วิธีสร้าง: openssl rand -hex 32
# ตัวอย่าง: 7f3a9c2b8e4d1f6a5b0c9e8d7f6a5b4c3d2e1f0a9b8c7d6e5f4a3b2c1d0e9f8a
API_KEY=CHANGE_ME_TO_YOUR_SECRET_API_KEY
